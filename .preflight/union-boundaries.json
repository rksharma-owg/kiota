{
  "openapi": "3.0.3",
  "info": {
    "title": "Primitive union",
    "version": "1"
  },
  "servers": [
    {
      "url": "https://example.com"
    }
  ],
  "paths": {
    "/things": {
      "get": {
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Thing"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Thing": {
        "type": "object",
        "properties": {
          "scalarValue": {
            "oneOf": [
              {
                "type": "boolean"
              },
              {
                "type": "integer"
              },
              {
                "type": "string"
              },
              {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            ]
          },
          "floatingValue": {
            "oneOf": [
              {
                "type": "number",
                "format": "double"
              },
              {
                "type": "string"
              }
            ]
          }
        }
      }
    }
  }
}